# Table Companion — local configuration
#
# Copy to a local env file only when you need one of these. With every variable unset
# the frontend runs entirely on local fixtures: no server, no account, no network.
# That is still the supported way to develop the UI on its own, and it is what a fresh
# clone does.
#
# There are two groups below and the split matters.
#
#   VITE_*  is inlined into the browser bundle by Vite. Anyone who loads the page can
#           read it. Never put a key, token, password or connection string in one.
#   The rest is read by the server process only and never leaves it. DATABASE_URL is a
#           credential: it belongs in your deployment's secret store, never in this file
#           and never in a commit.
#
# Never create a real env file by hand — run 06-CREATE-LOCAL-ENV.cmd.

NODE_ENV=development

# ── Frontend ────────────────────────────────────────────────────────────────────

# Base URL of the HTTP API. Unset => local fixtures.
# Every path the client will call is listed in src/domain/data/apiContract.ts.
#
# In development use the Vite dev-server proxy rather than a cross-origin URL: `/api` is
# forwarded to the backend, so the browser makes a same-origin request. That is also what
# TC-P02's SameSite session cookie will need.
#   VITE_API_BASE_URL=/api
VITE_API_BASE_URL=

# The realtime event stream. Unset => a same-machine BroadcastChannel, which is the explicit
# development adapter: enough to keep a DM tab and a player tab in step, and honest about
# reaching nothing else.
#
# Set it to the backend's `/events` and the app subscribes to a real server-sent event stream,
# authenticated by the same session cookie as every other request. Through the Vite dev-server
# proxy that is:
#   VITE_REALTIME_URL=/api/events
VITE_REALTIME_URL=

# ── Backend (server process only — never prefixed VITE_) ────────────────────────

# PostgreSQL connection string. Required by the server, `npm run db:migrate` and
# `npm run db:seed`. The value below matches the development database in
# docker-compose.yml, whose credentials are deliberately weak, local-only and disposable.
# A deployment supplies its own from a secret store.
DATABASE_URL=postgres://tablecompanion:localdev@127.0.0.1:5434/table_companion

# Port the backend listens on. Default 8787.
PORT=8787

# Where the Vite dev-server proxy forwards /api. Default http://localhost:8787.
TC_API_TARGET=http://localhost:8787

# Comma-separated origins accepted on an unsafe request (POST/PUT/DELETE) that arrives
# without a `Sec-Fetch-Site` header. Normally empty: the deployment is same-origin, browsers
# state their own provenance, and the session cookie is SameSite=Strict regardless. This is
# for a proxy or an older browser that strips the header. It is an allowlist — "*" is
# refused at startup, because there is no safe wildcard beside a cookie.
TC_ALLOWED_ORIGINS=

# Serve the API to a different origin than the page, with CORS. Off, and the default is the
# one to keep: the whole deployment story is same-origin, which is why no CORS header is
# emitted at all and why the session cookie can be SameSite=Strict. Turning this on requires
# TC_ALLOWED_ORIGINS and forces SameSite=None, which browsers only accept on a Secure cookie —
# so the server refuses it outside production. In development, use the Vite proxy.
TC_CROSS_ORIGIN=

# Believe X-Forwarded-For when deciding who a rate limit counts against. It is
# attacker-controlled unless a proxy you trust rewrites it, so this is off unless there is one.
TC_TRUST_PROXY=

# Which of the four environments this process is: development, test, staging, production.
#
# Separate from NODE_ENV, which the toolchain owns and which only really has two values. These
# four differ in what they are *allowed* to do: staging and production get Secure cookies and
# bind every interface, a laptop gets loopback and http. Unset means development — nothing
# gains a permission by being unlabelled. See DEPLOYMENT.md.
TC_ENV=

# The interface to bind. 0.0.0.0 in a container, loopback everywhere else. Rarely set by hand.
HOST=

# Directory of built static files to serve from this process, making it the web server as well
# as the API: the bundle at /, the API under /api. That is the same-origin topology in one
# container. Unset, this is an API and something in front serves the bundle.
#
#   TC_STATIC_DIR=/app/dist
TC_STATIC_DIR=

# Whether the process applies pending migrations as it boots.
#
# True on a laptop, where "start the server and have a working database" is the point. A
# deployment sets it to false and runs migrations as their own step, so a schema change is
# something an operator watches rather than a race between however many instances started at
# once. /ready reports 503 while anything is pending.
TC_MIGRATE_ON_BOOT=

# How long a shutdown waits for in-flight work before it stops waiting. Milliseconds, 15000 by
# default. A shutdown that waits forever is an instance an orchestrator has to kill.
TC_SHUTDOWN_GRACE_MS=

# Multiplies every rate limit. 1 by default, which is the shipped protection.
#
# The limiter counts an anonymous caller by address, because that is the only thing it can
# know about them — so a company behind one NAT, a university, a conference network and an
# automated test suite all look like one very busy person. Raise this where that is the case.
# It scales the count and never the window, and it is refused below 1: this exists to make the
# limits fit a topology, not to be turned off.
#
#   TC_RATE_LIMIT_SCALE=20
TC_RATE_LIMIT_SCALE=

# ── End-to-end tests ────────────────────────────────────────────────────────────
#
# `npm run e2e` builds its own world and destroys it on every run, so it needs a database it
# is allowed to destroy. Unset, it derives one from DATABASE_URL by appending `_e2e` to the
# database name — never the one above. Set this to point it somewhere else.
#
#   TC_E2E_DATABASE_URL=postgres://tablecompanion:localdev@127.0.0.1:5434/table_companion_e2e
TC_E2E_DATABASE_URL=

# The ports the suite runs its own stack on. Change either if something else holds one.
#   TC_E2E_API_PORT=8788
#   TC_E2E_APP_PORT=4174

# ── Signing in ──────────────────────────────────────────────────────────────────
#
# Authentication is real as of TC-P02. There is no environment variable that signs you in,
# and TC_DEV_USER_ID — TC-P01's identity shim — is refused at startup if it is still set.
#
# `npm run db:seed` gives every demo account the password `table-companion-dev` and an
# address of the form <id-without-u->@example.test. The demo world's DM is u-marta, so:
#
#     email:    marta@example.test
#     password: table-companion-dev
#
# That password is committed on purpose: it opens invented characters on a localhost
# database and guards nothing. The seed refuses to run when NODE_ENV=production.
