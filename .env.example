# Table Companion — local configuration
#
# Copy to a local env file only when you need one of these. With every variable unset
# the application runs entirely on local fixtures: no server, no account, no network.
# That is the supported way to develop the UI, and it is what a fresh clone does.
#
# SECURITY: every variable named VITE_* is inlined into the browser bundle by Vite.
# Never put a key, token, password or connection string in one. Nothing in this
# application reads a credential, and there is nowhere in this file for one.

NODE_ENV=development

# Base URL of the HTTP API. Unset => local fixtures.
# Every path the client will call is listed in src/domain/data/apiContract.ts.
# Example: VITE_API_BASE_URL=https://api.example.test/v1
VITE_API_BASE_URL=

# WebSocket URL for realtime combat events. Unset => a same-machine BroadcastChannel,
# which is enough to keep a DM tab and a player tab in step while developing.
# Example: VITE_REALTIME_URL=wss://api.example.test/v1/realtime
VITE_REALTIME_URL=
