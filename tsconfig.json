{
  "compilerOptions": {
    "target": "ES2022",
    // ES2023 for Array#toSorted — non-mutating sorts on shared fixture arrays. Supported
    // by every browser Vite targets and by the Node version the tests run on.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    // Node's ESM resolver needs a real extension to run the .ts tests directly under
    // its native type stripping. Safe here because the project never emits JS itself.
    "allowImportingTsExtensions": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src", "server", "vite.config.ts"]
}
